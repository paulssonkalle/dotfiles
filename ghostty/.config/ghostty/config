theme = dark:everforest-dark-soft.ghostty,light:everforest-light-hard.ghostty
palette-generate = true
font-family = Zed Mono Medium Extended
font-size = 13
adjust-cursor-thickness = 2
window-padding-x = 5
keybind = shift+enter=text:\x1b\r
keybind = super+k=text:\x01\x54
keybind = super+t=text:\x01\x63
keybind = super+w=text:\x01\x78


keybind = ctrl+digit_1=text:\x01\x31
keybind = ctrl+digit_2=text:\x01\x32
keybind = ctrl+digit_3=text:\x01\x33
keybind = ctrl+digit_4=text:\x01\x34
keybind = ctrl+digit_5=text:\x01\x35
keybind = ctrl+digit_6=text:\x01\x36
keybind = ctrl+digit_7=text:\x01\x37
keybind = ctrl+digit_8=text:\x01\x38
keybind = ctrl+digit_9=text:\x01\x39

keybind = super+l=text:\x01\x41
