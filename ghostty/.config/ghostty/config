theme = dark:everforest-dark-soft.ghostty,light:everforest-light-hard.ghostty
palette-generate = true
font-family = Zed Mono Medium Extended
font-size = 13
adjust-cursor-thickness = 2
window-padding-x = 5
keybind = shift+enter=text:\x1b\r
keybind = alt+k=text:\x01\x54
keybind = alt+t=text:\x01\x63
keybind = alt+w=text:\x01\x78


keybind = alt+digit_1=text:\x01\x31
keybind = alt+digit_2=text:\x01\x32
keybind = alt+digit_3=text:\x01\x33
keybind = alt+digit_4=text:\x01\x34
keybind = alt+digit_5=text:\x01\x35
keybind = alt+digit_6=text:\x01\x36
keybind = alt+digit_7=text:\x01\x37
keybind = alt+digit_8=text:\x01\x38
keybind = alt+digit_9=text:\x01\x39

keybind = alt+l=text:\x01\x41
