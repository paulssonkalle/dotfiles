// Everforest colours for niri. Include from config.kdl with:
//   include "everforest.kdl"
// niri has a single set of colours, so these are chosen to read well on both
// the dark soft and light hard backgrounds.

layout {
    focus-ring {
        width 2
        active-color "#a7c080"
        inactive-color "#859289"
        urgent-color "#e67e80"
    }

    border {
        off
    }

    tab-indicator {
        active-color "#a7c080"
        inactive-color "#859289"
        urgent-color "#e67e80"
    }

    insert-hint {
        color "#a7c08080"
    }

    shadow {
        color "#1e232670"
    }
}

environment {
    QT_QPA_PLATFORMTHEME "qt6ct"
}

spawn-at-startup "sh" "-c" "exec $HOME/.local/bin/everforest-follow"
