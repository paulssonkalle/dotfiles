{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "everforest-custom",
    "mode": "system"
  },
  "keybinds": {
    "model.cycle_recent": "none",
    "model.cycle_recent_reverse": "none",
    "model.cycle_favorite": "f2",
    "model.cycle_favorite_reverse": "shift+f2",
    "agent.cycle": "tab"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show",
    "markdown": "rendered",
    "verbosity": "medium",
    "permissions": "prompt"
  },
  "animations": true
}
